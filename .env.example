# ============================================================================
#  Cruise Price Checker -- Konfiguration
#  cp .env.example .env  und anschliessend anpassen.
#  Diese Datei enthaelt Secrets -> niemals ins Git-Repository committen.
# ============================================================================

# --- Ports / Reverse Proxy --------------------------------------------------
WEB_PORT=8080                 # Weboberflaeche: http://SERVER-IP:8080
BACKEND_PORT=8000             # Direkter API-Port (optional)
TZ=Europe/Berlin
# Nur setzen, wenn die App hinter einem Reverse Proxy unter einem Unterpfad laeuft:
# ROOT_PATH=/cruise
# VITE_BASE_PATH=/cruise/
VITE_API_BASE=/api

# --- Datenbank --------------------------------------------------------------
POSTGRES_DB=cruise
POSTGRES_USER=cruise
POSTGRES_PASSWORD=bitte-aendern
DATABASE_URL=postgresql+psycopg2://cruise:bitte-aendern@db:5432/cruise
# Alternative ohne Postgres (Container "db" kann dann entfallen):
# DATABASE_URL=sqlite:////data/cruise.db

# --- Datenverzeichnis (Screenshots, HTML-Snapshots, Browserprofile) --------
DATA_DIR=/data

# --- API-Absicherung --------------------------------------------------------
# Wenn gesetzt, brauchen alle schreibenden Endpunkte und der Adminbereich den
# Header X-API-Key (in der Weboberflaeche oben rechts eintragbar).
API_KEY=
CORS_ORIGINS=*

# --- Browserautomatisierung -------------------------------------------------
HEADLESS=true                 # false NUR zum Debuggen (sichtbarer Browser)
ENABLE_FIREFOX=true
BROWSER_TIMEOUT_MS=45000
NAVIGATION_TIMEOUT_MS=60000

# --- Rate Limiting / Hoeflichkeit gegenueber der Zielseite -----------------
MIN_DELAY_BETWEEN_STEPS_MS=1200
MAX_DELAY_BETWEEN_STEPS_MS=2600
DELAY_BETWEEN_PROFILES_S=8
MAX_CONCURRENT_SCANS=1
MAX_STEPS_PER_PROFILE=14
MAX_RETRIES_PER_PROFILE=2
RETRY_BACKOFF_BASE_S=5
MAX_SCANS_PER_CRUISE_PER_DAY=6
# Nach wie vielen blockierten Tests der gesamte Scan abbricht. 1 = beim ersten
# harten Block aufhören (respektiert die Entscheidung der Zielseite), 0 = nie.
ABORT_SCAN_AFTER_BLOCKS=1

# --- Funktionen -------------------------------------------------------------
ENABLE_SCHEDULER=true
ENABLE_MOCK_PROVIDER=true     # Demo-/Testprovider (mock://...) fuer Selbsttests
ENABLE_REFERRER_TESTS=false   # Google-/Bing-Referrer zusaetzlich testen
ENABLE_HTML_SNAPSHOTS=true
ENABLE_MULTI_ROUND_VERIFICATION=true
VERIFICATION_ROUNDS=3
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- Flugvergleich (vorbereitet, standardmaessig deaktiviert) --------------
ENABLE_FLIGHT_COMPARISON=false
PREFERRED_AIRPORTS=DUS,CGN,DTM,FRA,AMS

# --- Benachrichtigungen (alle optional) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
HOMEASSISTANT_WEBHOOK_URL=

# --- Proxys (optional, opt-in) ---------------------------------------------
# Nur eigene, legitime Zugaenge verwenden. Es werden keine Geo- oder
# Sicherheitsbeschraenkungen umgangen. Zugangsdaten erscheinen nie im
# Frontend und nie in Logs -- gespeichert wird ausschliesslich das Label.
# Format: http://user:pass@host:port  oder  socks5://host:port
PROXY_DE_1=
PROXY_DE_2=
PROXY_DE_3=
PROXY_DE_1_LABEL=DE Anschluss 1
PROXY_DE_2_LABEL=DE Anschluss 2
PROXY_DE_3_LABEL=DE Mobilfunk
